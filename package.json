{
  "name": "superjuego",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:achievements": "node --experimental-strip-types scripts/audit-achievements.mjs",
    "audit:levels": "node --experimental-strip-types scripts/audit-levels.mjs",
    "audit:progression": "node --experimental-strip-types scripts/audit-progression.mjs",
    "pwa:assets": "pwa-assets-generator --preset minimal-2023 public/favicon.svg",
    "preview": "vite preview --host 127.0.0.1",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:stop": "supabase stop"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@vitejs/plugin-react": "^4.5.2",
    "phaser": "^3.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vite-pwa/assets-generator": "^1.0.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}
