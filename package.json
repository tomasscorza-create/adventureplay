{
  "name": "adventureplay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && npm run audit:production",
    "lint": "eslint src scripts vite.config.ts eslint.config.js --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coop": "vitest run src/game/systems/net/coopMessages.test.ts src/game/systems/net/coopSecurity.test.ts src/game/systems/net/CoopDiagnostics.test.ts src/game/systems/net/CoopInputChannelTracker.test.ts src/game/systems/net/coopGuestReconciliation.test.ts src/game/systems/net/GuestCoopController.test.ts src/game/systems/net/coopSpawnLayout.test.ts src/game/systems/net/CoopSnapshotInterpolator.test.ts src/game/systems/net/CoopLocalPrediction.test.ts src/game/systems/net/CoopProjectilePuppets.test.ts src/game/systems/net/CoopSceneLink.test.ts src/game/systems/net/CoopMulticlient.test.ts --reporter=verbose",
    "test:watch": "vitest",
    "audit:achievements": "node --experimental-strip-types scripts/audit-achievements.mjs",
    "audit:levels": "node --experimental-strip-types scripts/audit-levels.mjs",
    "audit:progression": "node --experimental-strip-types scripts/audit-progression.mjs",
    "audit:production": "node scripts/audit-production.mjs",
    "pwa:assets": "pwa-assets-generator --preset minimal-2023 public/favicon.svg",
    "preview": "vite preview --host 127.0.0.1",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:stop": "supabase stop",
    "check": "npm run lint && npm run typecheck && npm run test && npm run audit:achievements && npm run audit:levels && npm run audit:progression && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@vitejs/plugin-react": "^4.5.2",
    "phaser": "^3.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vite-pwa/assets-generator": "^1.0.2",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "puppeteer": "^25.3.0",
    "typescript-eslint": "^8.62.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}
